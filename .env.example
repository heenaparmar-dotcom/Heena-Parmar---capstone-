# Copy this file to .env (already gitignored) and fill in real values.
# Never commit the real .env file.

# Google Cloud OAuth client (console.cloud.google.com -> APIs & Services ->
# Credentials). Enable the Gmail API and Google Calendar API on the same
# project, and add these scopes to the OAuth consent screen:
#   openid, email, profile, gmail.readonly, calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Groq API key (https://console.groq.com/keys) — free tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key (https://www.tavily.com) — free tier, no credit card required.
# Required for the real MCP web-search step.
TAVILY_API_KEY=

# Random long string used to sign the session cookie.
SESSION_SECRET=

# Optional
PORT=3000
