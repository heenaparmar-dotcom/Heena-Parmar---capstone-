# Copy this file to .env (already gitignored) and fill in real values.
# Never commit the real .env file.

# Google AI Studio API key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Tavily API key (https://www.tavily.com) — free tier, no credit card required.
# Required for the real MCP web-search step. Without it, the agent will run
# and fail honestly at the search step rather than fabricate results.
TAVILY_API_KEY=

# Optional
PORT=3000
